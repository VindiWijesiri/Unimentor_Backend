PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/unimentor?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Agora Video Calling Credentials (Get from https://console.agora.io/)
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE

# WA Client WhatsApp API (Get from https://waclient.com/dashboard)
WA_CLIENT_API_URL=https://api.waclient.com/api
WA_CLIENT_ACCESS_TOKEN=YOUR_WA_CLIENT_ACCESS_TOKEN
WA_CLIENT_INSTANCE_ID=YOUR_WA_CLIENT_INSTANCE_ID
