{
  "name": "unimentor-backend",
  "version": "1.0.0",
  "description": "UniMentor REST API — Node.js / Express / MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "render-build": "npm install && npm run build",
    "init-db": "ts-node --transpile-only src/scripts/initAtlas.ts",
    "test-db": "ts-node --transpile-only src/scripts/testConnection.ts",
    "reset-password": "ts-node --transpile-only src/scripts/resetPassword.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.10.6",
    "mongodb-memory-server": "^11.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
